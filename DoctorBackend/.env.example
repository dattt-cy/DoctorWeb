SPRING_PROFILES_ACTIVE=prod
PORT=8080

DB_URL=jdbc:mysql://database-host:3306/doctorweb?useSSL=true&serverTimezone=Asia/Ho_Chi_Minh&useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci
DB_USERNAME=doctorweb
DB_PASSWORD=replace-with-a-strong-password

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=86400000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

AUTH_COOKIE_SECURE=true
# Use Lax when frontend and API share the same parent domain.
# Use None only when they are truly cross-site; HTTPS is mandatory.
AUTH_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=https://www.example.com
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300
BOOKING_RATE_LIMIT=10
BOOKING_RATE_WINDOW_SECONDS=600
MAX_UPLOAD_SIZE=5MB

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
