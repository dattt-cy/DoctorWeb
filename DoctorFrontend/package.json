{
  "name": "doctor-frontend-temp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "vinext build && node scripts/prepare-sites-output.mjs",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint .",
    "dev:vinext": "vinext dev --port 3001",
